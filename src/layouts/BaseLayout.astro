---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { otherLang, ui, type Lang } from '../i18n';
import { pagePath, url } from '../utils';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** URL of this page in the other language; null when there is no translation. */
  alternate?: string | null;
  hero?: boolean;
}

const current = pagePath(Astro.url.pathname);
const { lang = current.lang, title, image, type = 'website', hero = false } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const description = Astro.props.description ?? t.description;
const alternate = Astro.props.alternate === undefined ? url(current.path, other) : Astro.props.alternate;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml', lang)} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#d3dfc6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#223022" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Zen+Maru+Gothic:wght@500;700&family=Zen+Old+Mincho:wght@400;700&display=swap"
    />

    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} alternate={alternate ?? url('/', other)} hero={hero} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
