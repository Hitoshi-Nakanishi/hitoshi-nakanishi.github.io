---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPosts, postUrl, type Post } from '../utils';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="Archive" description="すべての記事の一覧">
  <header class="page-header">
    <p class="page-kicker">Archive</p>
    <h1 class="page-title">すべての記事</h1>
    <p class="page-sub">{posts.length} 本の記事</p>
  </header>

  {
    [...byYear].map(([year, list]) => (
      <section class="archive-year">
        <h2 class="archive-year__label">{year}</h2>
        <ol class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
              <a href={postUrl(post)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
