---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils';
---

<BaseLayout lang="ja" title="Not Found" alternate={url('/', 'en')}>
  <header class="page-header">
    <p class="page-kicker">404</p>
    <h1 class="page-title">ページが見つかりません</h1>
    <p class="page-sub">このページは移動したか、まだ書かれていないようです。</p>
    <p class="page-sub" lang="en">This page has moved or hasn’t been written yet.</p>
    <p><a href={url('/')}>トップへ戻る</a> · <a href={url('/', 'en')} lang="en">Home (English)</a></p>
  </header>
</BaseLayout>
