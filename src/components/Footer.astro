---
import { SITE } from '../consts';
import type { Lang } from '../i18n';
import { url } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const span = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
---

<footer class="site-footer painted">
  <svg class="sleeping-cat" viewBox="2 6 60 32" aria-hidden="true">
    <defs>
      <clipPath id="sleeping-cat-body"><path d="M10 33C6 21 17 12 33 12C49 12 58 21 55 33Z"></path></clipPath>
    </defs>
    <g stroke="#3a3a30" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round">
      <path d="M10 33C6 21 17 12 33 12C49 12 58 21 55 33Z" fill="#fbf8f1"></path>
      <path d="M30 9C42 7 56 14 57 27C46 27 35 21 30 9Z" fill="#e3a15e" stroke="none" clip-path="url(#sleeping-cat-body)"></path>
      <path d="M10 33C6 21 17 12 33 12C49 12 58 21 55 33Z" fill="none"></path>
      <path d="M54 30C52 35.5 30 35.5 20 32.5" fill="none" stroke-width="5.6"></path>
      <path d="M54 30C52 35.5 30 35.5 20 32.5" fill="none" stroke="#e3a15e" stroke-width="3"></path>
      <path d="M8 22C7 16 8.5 12 11 11C13.5 12.5 15.5 15 16.5 18Z" fill="#fbf8f1"></path>
      <path d="M19 17C20.5 13.5 23 11 26 10.5C27 14 27 17.5 26 20Z" fill="#e3a15e"></path>
      <ellipse cx="17" cy="25" rx="11" ry="8.5" fill="#fbf8f1"></ellipse>
      <ellipse cx="10" cy="28.3" rx="2.2" ry="1.3" fill="#f4a9b5" stroke="none" opacity=".8"></ellipse>
      <ellipse cx="24" cy="28.3" rx="2.2" ry="1.3" fill="#f4a9b5" stroke="none" opacity=".8"></ellipse>
      <path d="M10.5 25q2 1.6 4 0M19.5 25q2 1.6 4 0M15.2 28.5q.9 1.1 1.8 0q.9 1.1 1.8 0" fill="none" stroke-width="1"></path>
    </g>
  </svg>
  <p>
    © {span} {SITE.author} · <a href={url('/rss.xml', lang)}>RSS</a> · <a href={SITE.github}>GitHub</a>
  </p>
</footer>
