---
import { NAV, SITE } from '../consts';
import { LANG_SHORT, LANGS, ui, type Lang } from '../i18n';
import { pagePath, url } from '../utils';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const t = ui[lang];
const { path } = pagePath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/posts/') : path.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={url('/', lang)}>{SITE.title}</a>
    <nav aria-label={t.mainNav}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href, lang)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="lang-switch" aria-label={t.langSwitch}>
          {
            LANGS.map((code) =>
              code === lang ? (
                <span aria-current="true">{LANG_SHORT[code]}</span>
              ) : (
                <a href={alternate} hreflang={code} lang={code} title={ui[code].readIn}>
                  {LANG_SHORT[code]}
                </a>
              ),
            )
          }
        </li>
        <li>
          <button class="theme-toggle" type="button" aria-label={t.themeToggle}>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path
                d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
              ></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const effective = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
