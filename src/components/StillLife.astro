---
// A jug of roses has dropped one onto the table. A stray cat naps with a paw on it,
// a lemon balanced on its back, next to a row of avocados: grown, growing, and today's pit.
const rose = 'M-9.5 1C-10-6-4-10.5 1.5-10C7.5-9.5 10.5-4 9.5 2C8.5 8 3 10.5-2 10C-7 9.5-9 6-9.5 1Z';
const curls = 'M-3.5.5C-4-3.5 1.5-5 3.5-2C5.5 1.5 2 4.5-1.5 3.5M-7 3.5C-5 7.5 2 8.5 6.5 4.5M6-5.5C3-8.5-3-8-6-4.5';
const leaf = 'M0 0C4-4.5 11-5 16 0C11 4.5 4 4.5 0 0Z';
const avocadoLeaf = 'M0 0C7-6.5 22-7 31 0C22 6.5 7 6 0 0Z';
const lemon = 'M-11 0C-8-8 8-8.5 11-.5C8 7.5-8 8-11 0Z';
const tail = 'M204 113C218 115 224 104 218 96C215 92 217 88 221 88';
const body = 'M140 118.5C138 101 152 90 172 90C192 90 207 101 207 118.5Z';

const greens = ['#4f7f37', '#6f9e4b', '#7ea957'];
const backLeaves = [
  [26, 50, 165, 0, 1],
  [32, 36, 215, 1, 0.9],
  [46, 29, 260, 2, 1],
  [54, 25, 250, 0, 0.7],
  [66, 24, 280, 0, 0.8],
  [84, 28, 300, 1, 1],
  [92, 30, 280, 2, 0.7],
  [100, 36, 335, 0, 0.9],
  [110, 54, 10, 2, 1],
  [104, 60, 20, 1, 0.7],
  [114, 66, 15, 0, 0.8],
  [100, 80, 50, 1, 1],
  [80, 82, 80, 0, 0.9],
  [44, 78, 115, 1, 1],
  [24, 72, 150, 2, 0.9],
  [20, 60, 150, 0, 0.8],
  [36, 56, 180, 0, 0.7],
];
const frontLeaves = [
  [57, 48, 330, 1, 0.75],
  [80, 54, 200, 0, 0.7],
  [74, 74, 40, 2, 0.75],
  [38, 55, 120, 0, 0.7],
  [96, 60, 300, 2, 0.65],
];
const roses = [
  [40, 46, 9, 10, '#f8ece6'],
  [58, 36, 10, -30, '#f0c6cb'],
  [77, 40, 11, 60, '#f6e3e1'],
  [95, 50, 9.5, 100, '#eab0b8'],
  [30, 62, 7, 80, '#f0c6cb'],
  [48, 62, 10.5, 120, '#f6e3e1'],
  [68, 58, 12, -80, '#f8ece6'],
  [88, 68, 10, 200, '#f0c6cb'],
  [106, 72, 7.5, 40, '#f6e3e1'],
  [60, 77, 8, 150, '#eab0b8'],
  [116, 87, 6.5, 250, '#f0c6cb'],
  [101, 111.5, 6.5, 30, '#eab0b8'],
];
// Pots are drawn around their base centre and scaled down along the row.
const potBody = 'M-16-23.5L-11.5 0H11.5L16-23.5Z';
const potRim = 'M-19-29.5C-7-30.5 7-30.5 19-29.9L18.2-23.1C6-22.5-6-22.5-18.2-23.1Z';
const stake = 'M8-41h4.5v12l-2.25 3-2.25-3Z';
const pots = [
  {
    x: 262,
    k: 1,
    stem: 'M0-38.5C1-50.5-4-62.5-10-76.5',
    leaves: [
      [-10, -76.5, 200, '#4f7a34'],
      [-10, -76.5, 300, '#6c9a47'],
      [-8, -70.5, 250, '#4f7a34'],
      [-5, -60.5, 345, '#6c9a47'],
      [-3, -51.5, 160, '#4f7a34'],
    ],
  },
  {
    x: 301,
    k: 0.78,
    stem: 'M0-38.5C0-46-2-52 1-60',
    leaves: [
      [1, -60, 285, '#6c9a47'],
      [1, -60, 215, '#4f7a34'],
      [0, -50, 335, '#4f7a34'],
    ],
  },
  { x: 332, k: 0.6, stem: null, leaves: [] },
];
---

<svg class="still-life" viewBox="6 12 340 112" aria-hidden="true">
  <defs>
    <clipPath id="still-life-body"><path d={body}></path></clipPath>
    <clipPath id="still-life-head"><ellipse cx="131" cy="106.5" rx="17" ry="12.5"></ellipse></clipPath>
  </defs>

  <path class="still-life__table" d="M10 118.5C80 117 140 119.5 200 118S300 117.5 342 118.6"></path>

  <g class="still-life__ink">
    <path
      d="M51.5 86C57 84.5 67 84.5 72.5 86C73 89.5 71 92 72 95C84 101 85.5 114 78 118.5H46.5C39 114 41 101 52.5 95C53.5 92 51 89.5 51.5 86Z"
      fill="#a9c3cd"></path>
    <path d="M44 106C54 109 70 109 81 106" fill="none" stroke="#d9a441" stroke-width="2"></path>
    <path d="M48 100C47 104 47 108 48 111" fill="none" stroke="#dbe7eb" stroke-width="1.6"></path>

    <path
      d="M28 66C22 56 28 44 38 40C42 30 54 26 64 30C74 24 90 28 96 38C108 42 114 56 108 66C114 74 108 84 98 82C90 88 76 86 70 84C60 90 46 86 40 80C32 80 28 74 28 66Z"
      fill="#5f8c43"
      stroke="none"></path>
    <g stroke-width="1.1">
      {
        backLeaves.map(([x, y, a, c, k]) => (
          <path d={leaf} transform={`translate(${x} ${y}) rotate(${a}) scale(${k})`} fill={greens[c]} vector-effect="non-scaling-stroke" />
        ))
      }
    </g>
    <path d="M50 50l3 2M70 48l-2 3M84 60l3-1M62 68l-3 2M78 66l2 3M40 70l3-2" fill="none" stroke="#3f6b35" stroke-width="3"></path>
    <path d="M38 52l4-3M86 42l3 3M92 58l4 1M58 30l3-2M28 64l3 1" fill="none" stroke="#a6c784" stroke-width="2"></path>
    <path d="M100 74C108 76 113 80 115 84M106 115.5C109 116.3 111 116.6 113 116.6" fill="none" stroke="#4f7f37"></path>
    {
      roses.map(([x, y, r, a, fill]) => (
        <g transform={`translate(${x} ${y}) rotate(${a}) scale(${Number(r) / 10})`}>
          <path d={rose} fill={fill} vector-effect="non-scaling-stroke" />
          <path d={curls} fill="none" stroke="#b9606f" vector-effect="non-scaling-stroke" />
        </g>
      ))
    }
    <g stroke-width="1.1">
      {
        frontLeaves.map(([x, y, a, c, k]) => (
          <path d={leaf} transform={`translate(${x} ${y}) rotate(${a}) scale(${k})`} fill={greens[c]} vector-effect="non-scaling-stroke" />
        ))
      }
    </g>

    <g class="still-life__tail" fill="none">
      <path d={tail} stroke="#3a3a30" stroke-width="7.5"></path>
      <path d={tail} stroke="#e3a15e" stroke-width="4.6"></path>
    </g>
    <path d={body} fill="#fbf8f1"></path>
    <path d="M160 86C172 82 192 86 197 99C188 105 168 104 160 96Z" fill="#e3a15e" stroke="none" clip-path="url(#still-life-body)"></path>
    <path d={body} fill="none"></path>

    <g transform="translate(176 84.5) rotate(-12)">
      <path d={lemon} fill="#f2d24a"></path>
      <path d="M-11 0l-2-.5M11-.5l2 .2" fill="none"></path>
      <path d="M-5-3.5q4-2.5 8-2" fill="none" stroke="#fbf0b8" stroke-width="1.8"></path>
    </g>
    <path d={leaf} transform="translate(183 79) rotate(-70) scale(.6)" fill="#5f8c40"></path>

    <ellipse cx="116" cy="116.3" rx="6" ry="3" fill="#fbf8f1"></ellipse>
    <path d="M112 115v2.2M114.6 114.6v2.6" fill="none" stroke-width="1"></path>
    <path d="M118 99C117 93 118.5 89 121 88C124 89.5 126.5 92 128 95Z" fill="#fbf8f1"></path>
    <path d="M136 95C138 92 141 89.5 144 88.5C146 91 146.5 95 144.5 100Z" fill="#e3a15e"></path>
    <ellipse cx="131" cy="106.5" rx="17" ry="12.5" fill="#fbf8f1"></ellipse>
    <path d="M133 92C141 87 152 92 151 104C145 106 137 102 133 92Z" fill="#e3a15e" stroke="none" clip-path="url(#still-life-head)"></path>
    <ellipse cx="131" cy="106.5" rx="17" ry="12.5" fill="none"></ellipse>
    <ellipse cx="119.5" cy="111" rx="3" ry="1.7" fill="#f4a9b5" stroke="none" opacity=".8"></ellipse>
    <ellipse cx="142.5" cy="111" rx="3" ry="1.7" fill="#f4a9b5" stroke="none" opacity=".8"></ellipse>
    <path d="M121 106.5q2.6 2.2 5.2 0M136 106.5q2.6 2.2 5.2 0M128.6 110.6q1.2 1.4 2.4 0q1.2 1.4 2.4 0" fill="none" stroke-width="1.2"></path>
    <path d="M130 108.6h2l-1 1Z" fill="#d98593" stroke-width=".8"></path>

    {
      pots.map(({ x, k, stem, leaves }) => (
        <g transform={`translate(${x} 118.5) scale(${k})`}>
          <path d={potBody} fill="#c97a52" vector-effect="non-scaling-stroke" />
          {stem && <path d={stem} fill="none" stroke="#6b7d3a" stroke-width="2.2" />}
          {leaves.map(([lx, ly, a, fill]) => (
            <g transform={`translate(${lx} ${ly}) rotate(${a}) scale(.85)`}>
              <path d={avocadoLeaf} fill={fill} vector-effect="non-scaling-stroke" />
              <path d="M3 0Q15-1 28 0" fill="none" stroke="#a7c27c" stroke-width="1" vector-effect="non-scaling-stroke" />
            </g>
          ))}
          <path d={stake} fill="#f7f3e8" vector-effect="non-scaling-stroke" />
          <path d="M9.3-38h2" fill="none" stroke-width="1" vector-effect="non-scaling-stroke" />
          <ellipse cy="-32.5" rx="7.5" ry="6.5" fill="#8b5a37" vector-effect="non-scaling-stroke" />
          {!stem && <path d="M0-38.5v4.5" fill="none" stroke="#5e3a22" vector-effect="non-scaling-stroke" />}
          <path d={potRim} fill="#d68a60" vector-effect="non-scaling-stroke" />
        </g>
      ))
    }
  </g>
</svg>
