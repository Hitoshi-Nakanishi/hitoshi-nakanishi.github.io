---
import BaseLayout from '../layouts/BaseLayout.astro';
import StillLife from '../components/StillLife.astro';
import { ui, type Lang } from '../i18n';
import { formatDate, getPosts, postUrl, postYear, type Post } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = postYear(post.data.date);
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout lang={lang} title="Archive" description={t.archiveDesc}>
  <header class="page-header">
    <StillLife part="pots" />
    <p class="page-kicker">Archive</p>
    <h1 class="page-title">{t.archiveTitle}</h1>
    <p class="page-sub">{t.count(posts.length)}</p>
  </header>

  {
    [...byYear].map(([year, list]) => (
      <section class="archive-year">
        <h2 class="archive-year__label">{year}</h2>
        <ol class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
              <span>
                <a href={postUrl(post)}>{post.data.title}</a>
                {post.data.draft && <span class="badge">draft</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
