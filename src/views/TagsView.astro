---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../i18n';
import { getPosts, tagUrl } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], lang));
---

<BaseLayout lang={lang} title="Tags" description={t.tagsDesc}>
  <header class="page-header">
    <p class="page-kicker">Index</p>
    <h1 class="page-title">{t.tagsTitle}</h1>
  </header>

  <ul class="tag-cloud">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={tagUrl(tag, lang)}>
            #{tag}
            <span class="tag-cloud__count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
